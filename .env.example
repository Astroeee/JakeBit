# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file.
SECRET_KEY=replace-with-a-long-random-string

# Set this only when running over HTTPS in production:
# PRODUCTION=1

# PostgreSQL connection string. Leave it out to use the local SQLite file (database/database.db).
# On Vercel, connecting a Neon database adds DATABASE_URL for you automatically.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
